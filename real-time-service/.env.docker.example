# Copy this file to .env.docker and replace every CHANGE_ME value.
# .env.docker is ignored by Git; never commit real secrets.
# Realtime WebSocket Service Docker
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# JWT (Must match api-gateway)
JWT_SECRET=CHANGE_ME

# Account status/token_version check for WebSocket auth
API_GATEWAY_URL=http://api-gateway:3000

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=SmartHomeDB
MONGO_DEVICE_SHADOWS_COLLECTION=device_shadows

# Redis
REDIS_URL=redis://redis:6379
