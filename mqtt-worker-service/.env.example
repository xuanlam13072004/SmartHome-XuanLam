# =========================
# Service
# =========================
NODE_ENV=development
SERVICE_NAME=mqtt-worker-service
LOG_LEVEL=info

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379
REDIS_OPERATION_STREAM=device.operations
REDIS_OPERATION_STATUS_STREAM=operation.status.stream
REDIS_OPERATION_GROUP=mqtt-operation-worker-group
REDIS_OPERATION_CONSUMER=worker-1
REDIS_CREDENTIAL_STREAM=device.credentials
REDIS_CREDENTIAL_STATUS_STREAM=credential.status.stream
REDIS_CREDENTIAL_GROUP=mqtt-credential-worker-group
REDIS_CREDENTIAL_CONSUMER=credential-worker-1
REDIS_UPDATE_CHANNEL=device.updates
REDIS_CACHE_OWNER_PREFIX=owner_of:
REDIS_CACHE_DEVICE_PREFIX=device:
REDIS_CACHE_TTL_SECONDS=3600

# =========================
# MQTT
# =========================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=mqtt-worker-service
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_CONTROL_TOPIC=smarthome/{device_id}/control
MQTT_HUB_CONTROL_TOPIC=smarthome/{hub_id}/hub/control
MQTT_TOPOLOGY_TOPIC=smarthome/{device_id}/topology
MQTT_TELEMETRY_TOPIC=smarthome/+/telemetry
MQTT_ACK_TOPIC=smarthome/+/ack
MQTT_TOPOLOGY_ACK_TOPIC=smarthome/+/topology/ack
MQTT_STATUS_TOPIC=smarthome/+/status
HUB_LEASE_SECONDS=15
DIRECT_FALLBACK_ROUTE_SECONDS=30

# =========================
# MongoDB
# =========================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=SmartHomeDB
MONGO_DEVICE_SHADOWS_COLLECTION=device_shadows
MONGO_TELEMETRY_COLLECTION=device_telemetry
MONGO_INGEST_RECEIPTS_COLLECTION=telemetry_ingest_receipts

# =========================
# Worker Behavior
# =========================
OPERATION_TIMEOUT_SECONDS=15
OPERATION_RETRY_LIMIT=2
OPERATION_MAX_RETRY=5
OPERATION_PROCESSING_TTL_SECONDS=120
OPERATION_IDEMPOTENCY_TTL_SECONDS=86400
HEARTBEAT_INTERVAL_SECONDS=30
TELEMETRY_DEDUPE_TTL_SECONDS=10

