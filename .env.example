# Docker Compose interpolation values for the root stack.
# Copy to .env (Git-ignored) and replace every CHANGE_ME with a random secret
# of at least 16 characters, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`.

# MQTT broker EMQX (docs/architecture/mqtt-security.md). Logins are rows of the
# PostgreSQL table mqtt_accounts; db-initialize writes the backend's own one.
# Broker account of mqtt-worker-service.
MQTT_WORKER_PASSWORD=CHANGE_ME
# Read-only PostgreSQL role emqx_auth, used by EMQX to check logins.
EMQX_AUTH_DB_PASSWORD=CHANGE_ME
# First password of the EMQX dashboard (http://localhost:18083, user admin).
# Changed later in the dashboard; this value is then no longer used.
EMQX_DASHBOARD_PASSWORD=CHANGE_ME
# Erlang node cookie of EMQX (inside the Docker network only); any long random value.
EMQX_NODE_COOKIE=CHANGE_ME
# Who can reach MQTT port 1883: 0.0.0.0 = the LAN (physical devices, a Simulator
# on a second computer; default); 127.0.0.1 = this computer only.
# MQTT_PUBLISH_HOST=0.0.0.0

# Factory API of the API Gateway (docs/architecture/mqtt-security.md, "API xưởng"):
# how the Device Simulator registers the virtual devices it makes. 32+ random
# characters; the same value goes into FACTORY_API_KEY of device-simulator/.env.docker.
# Empty = off.
FACTORY_API_KEY=

# Shared secret between api-gateway and voice-service (voice verification).
VOICE_SERVICE_TOKEN=CHANGE_ME

# Assistant: Gemini API key from Google AI Studio (empty = assistant off).
# Free-tier keys: Google may use prompts to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low

# Weather for automations, the assistant and the app (docs/architecture/weather.md).
# live: forecasts from Open-Meteo.com, free, no key (default): 63 areas refreshed
#       every 30 minutes, about 3,000 calls a day whatever the number of users.
# mock: the weather is set in the Admin Console → Thời tiết giả lập (demos, tests).
# off: no weather anywhere.
# WEATHER_MODE=live

# Payments for assistant plans (docs/architecture/payments.md).
# mock: orders can be "paid" with a test button, no money moves (default).
# bank: VietQR transfer to the account below.
# PAYMENT_MODE=mock
# PAYMENT_BANK_BIN=970422          # NAPAS BIN of the bank (970422 = MBBank, 970416 = ACB...)
# PAYMENT_BANK_ACCOUNT=0123456789  # account linked to SePay
# PAYMENT_ACCOUNT_NAME=NGUYEN VAN A
# PAYMENT_BANK_NAME=MBBank
# SePay webhook URL: https://<api hostname>/payments/sepay/webhook
# Authentication chosen in SePay: HMAC-SHA256 (recommended) or API Key.
# SEPAY_WEBHOOK_SECRET=
# SEPAY_API_KEY=

# Admin Console (docs/architecture/admin.md), http://localhost:4000.
# Server key between the Console and the API Gateway's /admin API (32+ random
# characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Empty = no administration at all.
ADMIN_API_KEY=
# The Simulator's ADMIN_TOKEN (device-simulator/.env.docker): lets the Console
# open the "Simulator" section for staff allowed to use it. Empty = no Simulator section.
SIMULATOR_ADMIN_TOKEN=
# Where the Simulator's backend is: this computer (default) or, with the
# Simulator on a second computer, http://<its IP>:4001 (docs/architecture/load-testing.md).
# SIMULATOR_URL=http://host.docker.internal:4001
# Who can open the Console: 127.0.0.1 = this computer (default); 0.0.0.0 = the LAN.
# ADMIN_CONSOLE_HOST=127.0.0.1
# ADMIN_CONSOLE_COOKIE_SECURE=false   # true when the Console is served over HTTPS

# Grafana admin password (only with `docker compose --profile monitoring up -d`,
# docs/architecture/load-testing.md). Viewing the dashboard needs no sign-in.
# GRAFANA_ADMIN_PASSWORD=admin

# Registrations and sign-ins per address and minute on the API Gateway (defaults
# 20 and 100). Raise both to 1200 only while a load test creates its users, with
# GATEWAY_REGISTER_PER_MINUTE / GATEWAY_LOGIN_PER_MINUTE in device-simulator/.env.docker,
# then set them back: the Gateway is on the internet through the tunnel.
# RATE_LIMIT_REGISTER_PER_IP_PER_MINUTE=20
# RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=100

# Push notifications (docs/architecture/push.md): no variable here. Put the
# Firebase service account JSON at secrets/firebase-service-account.json.

# Cloudflare Tunnel (docs/cloudflare-tunnel.md): the tunnel's credentials file,
# created by `cloudflared tunnel create`; it is mounted read-only, never copied.
# CLOUDFLARED_CREDENTIALS_FILE=C:/Users/<you>/.cloudflared/<tunnel-id>.json

# Where the API (3000), realtime (3001) and media (8090) ports are published.
# Default 127.0.0.1: this computer only (the Android emulator reaches it as
# 10.0.2.2); from outside, through the cloudflared service. 0.0.0.0 opens them to the LAN
# (phone by IP); then also set TRUST_PROXY= (empty) so nobody on the LAN can
# fake a client address.
# PUBLISH_HOST=127.0.0.1
# Proxies the API Gateway believes about the client address (X-Forwarded-For).
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Camera media relay (optional overrides; see docker-compose.yml).
# URL the app's HLS player opens; how video leaves the house is decided in
# docs/architecture/camera-contract.md §11.1.
# MEDIA_PUBLIC_URL=http://localhost:8090
# URL cameras dial for ingest. Virtual cameras reach it as media-relay-service
# on this computer or, with the Simulator on a second computer, through
# PUBLISH_HOST=0.0.0.0 (docker-compose.simulator.yml maps the name).
# MEDIA_INGEST_URL=ws://media-relay-service:8090/v1/ingest

# ── Only on the Simulator's computer, when it is not this one ───────────────
# (docker-compose.simulator.yml; docs/architecture/load-testing.md, "Hai máy")
# IP of the system's computer; empty = the Simulator runs on this computer.
# SMARTHOME_SYSTEM_HOST=192.168.1.10
# 0.0.0.0 lets the system's computer (its Admin Console) reach the Simulator.
# SIMULATOR_PUBLISH_HOST=0.0.0.0
