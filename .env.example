# Docker Compose interpolation values for the root stack.
# Copy to .env (Git-ignored) and replace every CHANGE_ME with a random secret
# of at least 16 characters, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`.

# Mosquitto Dynamic Security administrator. Only applied when the broker
# creates E:/smarthome_data/mosquitto/dynamic-security.json for the first time.
MQTT_ADMIN_PASSWORD=CHANGE_ME
# Broker identity of mqtt-worker-service.
MQTT_WORKER_PASSWORD=CHANGE_ME
# Broker identity that registers device credentials (used by Device Simulator
# as the virtual-device factory and by provisionDeviceIdentity.js).
MQTT_FACTORY_PASSWORD=CHANGE_ME

# Shared secret between api-gateway and voice-service (voice verification).
VOICE_SERVICE_TOKEN=CHANGE_ME

# Assistant: Gemini API key from Google AI Studio (empty = assistant off).
# Free-tier keys: Google may use prompts to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low

# Cloudflare Tunnel (docs/cloudflare-tunnel.md): the tunnel's credentials file,
# created by `cloudflared tunnel create`; it is mounted read-only, never copied.
# CLOUDFLARED_CREDENTIALS_FILE=C:/Users/<you>/.cloudflared/<tunnel-id>.json

# Where the API (3000), realtime (3001) and media (8090) ports are published.
# Default 127.0.0.1: this computer only (the Android emulator reaches it as
# 10.0.2.2); from outside, through the cloudflared service. 0.0.0.0 opens them to the LAN
# (phone by IP); then also set TRUST_PROXY= (empty) so nobody on the LAN can
# fake a client address.
# PUBLISH_HOST=127.0.0.1
# Proxies the API Gateway believes about the client address (X-Forwarded-For).
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Camera media relay (optional overrides; see docker-compose.yml).
# URL the app's HLS player opens; how video leaves the house is decided in
# docs/architecture/camera-contract.md §11.1.
# MEDIA_PUBLIC_URL=http://localhost:8090
# URL cameras dial for ingest (virtual cameras run inside Docker).
# MEDIA_INGEST_URL=ws://media-relay-service:8090/v1/ingest
