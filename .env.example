# Docker Compose interpolation values for the root stack.
# Copy to .env (Git-ignored) and replace every CHANGE_ME with a random secret
# of at least 16 characters, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`.

# Mosquitto Dynamic Security administrator. Only applied when the broker
# creates E:/smarthome_data/mosquitto/dynamic-security.json for the first time.
MQTT_ADMIN_PASSWORD=CHANGE_ME
# Broker identity of mqtt-worker-service.
MQTT_WORKER_PASSWORD=CHANGE_ME
# Broker identity that registers device credentials (used by Device Simulator
# as the virtual-device factory and by provisionDeviceIdentity.js).
MQTT_FACTORY_PASSWORD=CHANGE_ME

# Camera media relay (optional overrides; see docker-compose.yml).
# URL the app's HLS player opens. Use the machine's LAN address or the
# Cloudflare route when the app does not run on this computer.
# MEDIA_PUBLIC_URL=http://localhost:8090
# URL cameras dial for ingest (virtual cameras run inside Docker).
# MEDIA_INGEST_URL=ws://media-relay-service:8090/v1/ingest
