# Copy this file to .env.docker before starting docker-compose.simulator.yml
# (repository root). The Simulator reaches the system only through its official
# doors: the public API and the factory API (port 3000) and MQTT (port 1883).
# Where the system is (this computer or another) is set in the compose file;
# MONGODB_URI, API_GATEWAY_URL and MQTT_HOST below are only used outside Docker.
PORT=4001
HOST=0.0.0.0
NODE_ENV=production

SIMULATOR_ENABLED=true
ALLOW_PRODUCTION_SIMULATOR=true
# Service token of the Admin Console (not typed by people): the same value as
# SIMULATOR_ADMIN_TOKEN in the root .env of the system's computer.
ADMIN_TOKEN=replace-with-a-long-random-admin-token
ADMIN_CORS_ORIGINS=http://localhost:4000
# Encrypts the secrets of virtual users and devices in the Simulator's MongoDB
# (passwords, claim secrets, MQTT passwords). Keep it: records made with another
# key can no longer be used (their devices cannot log in, their users cannot be cleaned).
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# X-Factory-Key of the factory API: the same value as FACTORY_API_KEY in the
# root .env of the system's computer (32+ characters).
FACTORY_API_KEY=CHANGE_ME_TO_THE_SYSTEMS_FACTORY_API_KEY

API_GATEWAY_URL=http://localhost:3000
API_REQUEST_TIMEOUT_MS=15000
STARTUP_RETRY_ATTEMPTS=30
STARTUP_RETRY_DELAY_MS=2000
# Generation pacing. Must not exceed the API Gateway's RATE_LIMIT_REGISTER_PER_IP_PER_MINUTE,
# RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE (root .env) and RATE_LIMIT_CLAIM_PER_ACCOUNT_PER_MINUTE.
# For a large load test raise both sides together (e.g. register and sign-in 1200/min).
GATEWAY_REGISTER_PER_MINUTE=20
GATEWAY_LOGIN_PER_MINUTE=100
GATEWAY_CLAIM_PER_ACCOUNT_PER_MINUTE=10
# Users generated at the same time (each: register, one factory call, claims).
GENERATION_CONCURRENCY=8
MAX_USERS_PER_RUN=10000
MAX_DEVICES_PER_RUN=40000
MAX_ACTIVE_DEVICES=40000
MAX_TELEMETRY_MESSAGES_PER_SECOND=2000
TELEMETRY_PUBLISH_CONCURRENCY=100
METRICS_FLUSH_INTERVAL_MS=1000
METRICS_RATE_WINDOW_SECONDS=60
REGISTRY_STATE_FLUSH_INTERVAL_MS=5000
SEQUENCE_LEASE_SIZE=500

# The Simulator's own database (its registry); never the system's.
MONGODB_URI=mongodb://localhost:27019
SIMULATOR_MONGO_DB_NAME=DeviceSimulatorDB

MQTT_HOST=localhost
MQTT_PORT=1883
# How MQTT connections are opened in bulk (generation, restart, "Bật lại thiết bị"):
# at most this many start per second and this many wait for their CONNACK at once.
# A device that cannot connect yet is retried later (5 s, 10 s, 20 s… up to 5 min).
MQTT_CONNECTS_PER_SECOND=50
MQTT_CONNECT_CONCURRENCY=200
MQTT_CONNECT_TIMEOUT_MS=30000
MQTT_CONTROL_TOPIC=smarthome/{device_id}/control
MQTT_HUB_CONTROL_TOPIC=smarthome/{hub_id}/hub/control
MQTT_TELEMETRY_TOPIC=smarthome/{device_id}/telemetry
MQTT_EVENT_TOPIC=smarthome/{device_id}/events
MQTT_ACK_TOPIC=smarthome/{device_id}/ack
MQTT_STATUS_TOPIC=smarthome/{device_id}/status
MQTT_TOPOLOGY_TOPIC=smarthome/{device_id}/topology
MQTT_TOPOLOGY_ACK_TOPIC=smarthome/{device_id}/topology/ack
OPERATION_DEDUP_TTL_MS=600000

CLEANUP_INTERVAL_MS=900000
CLEANUP_RETENTION_HOURS=24
# Users cleaned at the same time by "Dọn dữ liệu" (each: unpair, delete the account, retire).
CLEANUP_CONCURRENCY=8
EVENT_RETENTION_DAYS=7
MAX_PAGE_SIZE=200

# Virtual camera storage (virtual SD card). Docker keeps it in a named volume
# mounted at /var/lib/simulator-media; outside Docker the path is relative to the backend.
# Whole-store quota for all virtual cameras; oldest minutes are recycled.
SIMULATOR_MEDIA_QUOTA_BYTES=10737418240

# Simulator factory (blank devices with QR labels).
FACTORY_TELEMETRY_INTERVAL_SECONDS=30
FACTORY_MAX_BATCH_SIZE=20
