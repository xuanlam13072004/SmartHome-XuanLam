# Simulator Backend Configuration
PORT=4001
HOST=0.0.0.0
NODE_ENV=development

# Admin Security
SIMULATOR_ENABLED=true
ADMIN_TOKEN=your-secure-admin-token
CREDENTIAL_ENCRYPTION_KEY=32-byte-hex-string-for-aes-256-gcm

# API Gateway
API_GATEWAY_URL=http://localhost:3000

# PostgreSQL (Main Database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smarthome
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# MongoDB (Registry Database)
MONGODB_URI=mongodb://localhost:27017/DeviceSimulatorDB

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
