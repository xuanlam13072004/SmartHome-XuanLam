# Device Simulator backend
PORT=4001
HOST=0.0.0.0
NODE_ENV=development

# Safety and admin access
SIMULATOR_ENABLED=true
ALLOW_PRODUCTION_SIMULATOR=false
ADMIN_TOKEN=replace-with-a-long-random-admin-token
ADMIN_CORS_ORIGINS=http://localhost:4000,http://localhost:5173
# Development-only example. Generate a private 32-byte key before sharing an environment.
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# API Gateway
API_GATEWAY_URL=http://localhost:3000
API_REQUEST_TIMEOUT_MS=15000
STARTUP_RETRY_ATTEMPTS=30
STARTUP_RETRY_DELAY_MS=2000
# Defaults stay below the current /auth/register and /devices/claim rate limits.
REGISTRATION_DELAY_MS=12500
CLAIM_DELAY_MS=6500
# Workload guardrails. Increase deliberately after measuring the host and backend.
MAX_USERS_PER_RUN=10000
MAX_DEVICES_PER_RUN=10000
MAX_ACTIVE_DEVICES=10000
MAX_TELEMETRY_MESSAGES_PER_SECOND=1000
TELEMETRY_PUBLISH_CONCURRENCY=100
METRICS_FLUSH_INTERVAL_MS=1000
METRICS_RATE_WINDOW_SECONDS=60
REGISTRY_STATE_FLUSH_INTERVAL_MS=5000

# Main PostgreSQL database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smarthome
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Simulator registry and main SmartHome MongoDB database
MONGODB_URI=mongodb://localhost:27017
SIMULATOR_MONGO_DB_NAME=DeviceSimulatorDB
# Leave empty when both databases use the same MongoDB server.
MAIN_MONGODB_URI=
MAIN_MONGO_DB_NAME=SmartHomeDB
MAIN_MONGO_DEVICE_SHADOWS_COLLECTION=device_shadows
MAIN_MONGO_TELEMETRY_COLLECTION=device_telemetry
MAIN_MONGO_INGEST_RECEIPTS_COLLECTION=telemetry_ingest_receipts

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_CONTROL_TOPIC=smarthome/{device_id}/control
MQTT_HUB_CONTROL_TOPIC=smarthome/{hub_id}/hub/control
MQTT_TELEMETRY_TOPIC=smarthome/{device_id}/telemetry
MQTT_ACK_TOPIC=smarthome/{device_id}/ack
MQTT_STATUS_TOPIC=smarthome/{device_id}/status
MQTT_TOPOLOGY_TOPIC=smarthome/{device_id}/topology
MQTT_TOPOLOGY_ACK_TOPIC=smarthome/{device_id}/topology/ack
OPERATION_DEDUP_TTL_MS=600000

# Retention and dashboard paging
CLEANUP_INTERVAL_MS=900000
CLEANUP_RETENTION_HOURS=24
EVENT_RETENTION_DAYS=7
MAX_PAGE_SIZE=200
