# API Gateway
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Proxies allowed to set X-Forwarded-For (Cloudflare Tunnel). Empty when the
# Gateway is reached directly; docker-compose sets it (see .env.example at the root).
TRUST_PROXY=
# Voice verification service (docs/architecture/voice.md); empty token = voice off.
VOICE_SERVICE_URL=http://localhost:8000
VOICE_SERVICE_TOKEN=
# Assistant (docs/architecture/assistant.md); empty key = assistant off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Payments (docs/architecture/payments.md): off | mock | bank.
PAYMENT_MODE=mock
PAYMENT_BANK_BIN=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_NAME=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
# Push notifications (docs/architecture/push.md): path of the Firebase service
# account JSON (a secret); empty = push off.
FCM_SERVICE_ACCOUNT_FILE=

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Account center: active sessions per account, members + open invitations per device, invitation lifetime
MAX_SESSIONS_PER_ACCOUNT=20
MAX_DEVICE_MEMBERS=10
INVITE_TTL_HOURS=168
MAX_ROOMS_PER_ACCOUNT=30
MAX_SCENES_PER_ACCOUNT=50
MAX_SCENE_STEPS=10
SCENE_RUN_RETENTION_DAYS=30
MAX_SCHEDULES_PER_SCENE=5
MAX_AUTOMATIONS_PER_ACCOUNT=30
ACCOUNT_NOTIFICATION_RETENTION_DAYS=30

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smarthome
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSL=false

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=SmartHomeDB
MONGO_DEVICE_SHADOWS_COLLECTION=device_shadows
MONGO_ACTIVE_OPERATIONS_COLLECTION=active_operations

# Redis
REDIS_URL=redis://localhost:6379
REDIS_OPERATION_STREAM=device.operations
REDIS_OPERATION_STATUS_STREAM=operation.status.stream
REDIS_CREDENTIAL_STREAM=device.credentials
REDIS_CREDENTIAL_STATUS_STREAM=credential.status.stream
REDIS_CACHE_OWNER_PREFIX=owner_of:
REDIS_CACHE_TTL_SECONDS=3600
OPERATION_TIMEOUT_SECONDS=30
TOPOLOGY_ELECTION_TIMEOUT_SECONDS=30
TOPOLOGY_HUB_LEASE_SECONDS=15


# Rate limits (requests/minute), keyed by account/email/session rather than IP.
# Raise these only in a dedicated load-test environment.
RATE_LIMIT_REGISTER_PER_IP_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_EMAIL_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=100
RATE_LIMIT_REFRESH_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_CLAIM_PER_ACCOUNT_PER_MINUTE=10
RATE_LIMIT_OPERATIONS_PER_ACCOUNT_PER_MINUTE=30

# Media relay for camera sessions (docs/architecture/camera-contract.md).
# Run media-relay-service locally (port 8090) and set both; without them camera
# sessions are refused with MEDIA_RELAY_NOT_CONFIGURED.
# MEDIA_PUBLIC_URL=http://localhost:8090
# MEDIA_INGEST_URL=ws://localhost:8090/v1/ingest
