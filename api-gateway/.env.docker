# API Gateway Docker
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT
JWT_SECRET=e5b8d9c2a1f4e7b6d5c4a3b2e1f0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2
JWT_EXPIRES_IN=900
REFRESH_TOKEN_TTL_SECONDS=604800

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=smarthome
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSL=false

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=SmartHomeDB
MONGO_DEVICE_SHADOWS_COLLECTION=device_shadows
MONGO_TELEMETRY_COLLECTION=device_telemetry
MONGO_ACTIVE_OPERATIONS_COLLECTION=active_operations

# Redis
REDIS_URL=redis://redis:6379
REDIS_OPERATION_STREAM=device.operations
REDIS_OPERATION_STATUS_STREAM=operation.status.stream
REDIS_CREDENTIAL_STREAM=device.credentials
REDIS_CREDENTIAL_STATUS_STREAM=credential.status.stream
REDIS_CACHE_OWNER_PREFIX=owner_of:
REDIS_CACHE_TTL_SECONDS=3600
OPERATION_TIMEOUT_SECONDS=30
TOPOLOGY_ELECTION_TIMEOUT_SECONDS=30
TOPOLOGY_HUB_LEASE_SECONDS=15
