# Copy this file to .env.docker and replace every CHANGE_ME value.
# .env.docker is ignored by Git; never commit real secrets.
# API Gateway Docker
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=900
REFRESH_TOKEN_TTL_SECONDS=604800

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=smarthome
PG_USER=postgres
# Must match POSTGRES_PASSWORD in docker-compose.yml
PG_PASSWORD=postgres
PG_SSL=false

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=SmartHomeDB
MONGO_DEVICE_SHADOWS_COLLECTION=device_shadows
MONGO_TELEMETRY_COLLECTION=device_telemetry
MONGO_ACTIVE_OPERATIONS_COLLECTION=active_operations

# Redis
REDIS_URL=redis://redis:6379
REDIS_OPERATION_STREAM=device.operations
REDIS_OPERATION_STATUS_STREAM=operation.status.stream
REDIS_CREDENTIAL_STREAM=device.credentials
REDIS_CREDENTIAL_STATUS_STREAM=credential.status.stream
REDIS_CACHE_OWNER_PREFIX=owner_of:
REDIS_CACHE_TTL_SECONDS=3600
OPERATION_TIMEOUT_SECONDS=30
TOPOLOGY_ELECTION_TIMEOUT_SECONDS=30
TOPOLOGY_HUB_LEASE_SECONDS=15

# Rate limits (requests/minute), keyed by account/email/session rather than IP.
# Raise these only in a dedicated load-test environment.
RATE_LIMIT_REGISTER_PER_IP_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_EMAIL_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=100
RATE_LIMIT_REFRESH_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_CLAIM_PER_ACCOUNT_PER_MINUTE=10
RATE_LIMIT_OPERATIONS_PER_ACCOUNT_PER_MINUTE=30
